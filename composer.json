{
    "name": "qubeintegrations/qube_sync_php",
    "description": "Unsupported proof of concept of a PHP wrapper for the QubeSync API. Don't use it to verify webhooks.",
    "abandoned": true,
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Garrett Lancaster",
            "email": "glancast@garrettlancaster.com"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
          "QubeSync\\": "src/QubeSync/"
        }
      },
    "autoload-dev": {
        "psr-4": {
          "QubeSync\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    }
}
